# Deployment environment. Drives ASP.NET Core behaviour and the environment tag on every
# Sentry event. Standard values are Development, Staging and Production; .NET falls back to
# Production when unset, so anything non-production must set it explicitly.
#
# The JobRunner reads DOTNET_ENVIRONMENT instead, but do not set it here: compose.yaml feeds
# this file into the API container, and under WebApplication DOTNET_ENVIRONMENT silently
# outranks ASPNETCORE_ENVIRONMENT. The JobRunner gets its value from its own deployment config.
#
# Set SENTRY_ENVIRONMENT only to tag events differently from the .NET environment — e.g. blue
# and green slots that share one Production configuration. It overrides the above on both the
# API and the JobRunner.
ASPNETCORE_ENVIRONMENT=Development

# Database
POSTGRES_DB=trumandb
POSTGRES_USER=truman
POSTGRES_PASSWORD=password

# API Configuration
Authentication__Jwt__Key=your-secret-key-here
Authentication__Jwt__Issuer=truman-api
Authentication__Jwt__Audience=truman-web

# OAuth Providers
Authentication__Facebook__AppId=your-facebook-app-id
Authentication__Facebook__AppSecret=your-facebook-app-secret
Authentication__Google__ClientId=your-google-client-id
Authentication__Google__ClientSecret=your-google-client-secret

# Admin allowlist (comma-separated emails granted the "admin" role at login)
ADMIN_EMAILS=

# Email
Email__Brevo__ApiKey=your-brevo-api-key
Email__Brevo__MagicLinkTemplateId=1

# Frontend
Frontend__BaseUrl=http://localhost:3000

# AI Configuration
AI__Model=gemini-2.5-flash-lite-preview-06-17
AI__ApiKey=your-ai-api-key 

# Sentry
Sentry__Dsn=your_sentry_dsn