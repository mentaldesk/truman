<Project>
  <PropertyGroup>
    <SentryOrg>mental-desk-ltd</SentryOrg>
    <SentryProject>truman</SentryProject>
    <SentryUploadSymbols>true</SentryUploadSymbols>
    <SentryUploadSources>true</SentryUploadSources>
  </PropertyGroup>

  <!-- Derives the version from git tags. The container build has no .git, so CI passes the
       version it computed through MinVerVersionOverride instead. See the Dockerfiles. -->
  <PropertyGroup>
    <!-- Tags are v-prefixed, and CI's minver-cli is invoked with the matching -t v. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseSentryCLI>false</UseSentryCLI>
  </PropertyGroup>
</Project>
